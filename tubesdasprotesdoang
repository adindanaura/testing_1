#include <stdio.h>

// Warna ANSI sederhana untuk tampilan visual
#define MERAH   "\033[1;31m"
#define HIJAU   "\033[1;32m"
#define KUNING  "\033[1;33m"
#define BIRU    "\033[1;36m"
#define RESET   "\033[0m"

// Deklarasi Fungsi (Function Prototype)
void buatKopiStandar();
void buatCustomBlend();
void cetakLoading();

int main() {
    int menu;
    char ulang;

    // LOOPING (do-while)
    do {
        printf("\n%s=========================================%s\n", KUNING, RESET);
        printf("%s   MODUL 3: PROSES PEMBUATAN KOPI        %s\n", KUNING, RESET);
        printf("%s=========================================%s\n", KUNING, RESET);
        printf("1. Buat Kopi Standar (Menu)\n");
        printf("2. Buat Custom Blend (Racik Sendiri)\n");
        printf("0. Keluar\n");
        printf("Pilih menu (0-2): ");
        scanf("%d", &menu);

        // PERCABANGAN (switch-case)
        switch (menu) {
            case 1:
                buatKopiStandar();
                break;
            case 2:
                buatCustomBlend();
                break;
            case 0:
                printf("%sTerima kasih! Keluar dari modul 3.%s\n", HIJAU, RESET);
                break;
            default:
                printf("%sPilihan tidak ada! Coba lagi.%s\n", MERAH, RESET);
                break;
        }

        if (menu != 0) {
            printf("\nApakah ingin meracik kopi lagi? (y/n): ");
            scanf(" %c", &ulang);
        } else {
            ulang = 'n';
        }

    } while (ulang == 'y' || ulang == 'Y');

    return 0;
}

// Fungsi untuk simulasi penyeduhan (Loading bar)
void cetakLoading() {
    int i, d;
    printf("%sSedang menyeduh kopi: [%s", BIRU, RESET);
    
    // LOOPING (for)
    for (i = 0; i < 10; i++) {
        printf("%s#%s", HIJAU, RESET);
        // Delay visual sederhana
        for (d = 0; d < 12000000; d++); 
    }
    printf("%s] 100%% Selesai!%s\n", BIRU, RESET);
}

// Fungsi 1: Membuat Kopi Standar
void buatKopiStandar() {
    int pilihan;

    printf("\n%s--- PILIH VARIAN KOPI ---%s\n", KUNING, RESET);
    printf("1. Espresso (Pekat)\n");
    printf("2. Latte (Manis & Susu)\n");
    printf("3. Americano (Sedang)\n");
    printf("Pilih (1-3): ");
    scanf("%d", &pilihan);

    // PERCABANGAN (if-else)
    if (pilihan == 1) {
        printf("\nMenyeduh Espresso...\n");
        cetakLoading();
        printf("%s[SUKSES] Kopi Espresso berhasil dibuat! Rasa sangat pekat.%s\n", HIJAU, RESET);
    } else if (pilihan == 2) {
        printf("\nMenyeduh Latte...\n");
        cetakLoading();
        printf("%s[SUKSES] Kopi Latte berhasil dibuat! Rasa creamy dan manis.%s\n", HIJAU, RESET);
    } else if (pilihan == 3) {
        printf("\nMenyeduh Americano...\n");
        cetakLoading();
        printf("%s[SUKSES] Kopi Americano berhasil dibuat! Rasa pas.%s\n", HIJAU, RESET);
    } else {
        printf("%s[ERROR] Pilihan varian tidak valid!%s\n", MERAH, RESET);
    }
}

// Fungsi 2: Custom Blend (Racik Sendiri)
void buatCustomBlend() {
    // VARIABEL & TIPE DATA
    int kopi, air, susu, gula;
    int totalVolume;
    int i;

    printf("\n%s--- RACIK KOPI CUSTOM SENDIRI ---%s\n", KUNING, RESET);
    printf("Masukkan jumlah Kopi (gram): ");
    scanf("%d", &kopi);
    printf("Masukkan jumlah Air (ml): ");
    scanf("%d", &air);
    printf("Masukkan jumlah Susu (ml): ");
    scanf("%d", &susu);
    printf("Masukkan jumlah Gula (ml): ");
    scanf("%d", &gula);

    totalVolume = air + susu + gula;

    // PERCABANGAN 1: Cek kapasitas gelas
    if (totalVolume > 350) {
        printf("%s[GAGAL] Total racikan %dml! Gelas meluap (maksimal 350ml).%s\n", MERAH, totalVolume, RESET);
    } else {
        printf("\n%s[PROSES] Mencampur semua bahan...%s\n", BIRU, RESET);
        
        // LOOPING (for) untuk proses pengocokan
        for (i = 1; i <= 3; i++) {
            printf("Kocok racikan ke-%d...\n", i);
        }
        
        cetakLoading();

        printf("\n%s=========================================%s\n", HIJAU, RESET);
        printf("%s        RACIKAN CUSTOM BERHASIL!         %s\n", HIJAU, RESET);
        printf("%s=========================================%s\n", HIJAU, RESET);
        printf("Total Volume : %d ml\n", totalVolume);
        printf("Komposisi    : %dg Kopi, %dml Air, %dml Susu, %dml Gula\n", kopi, air, susu, gula);
        
        // PERCABANGAN 2: Penentuan profil rasa
        printf("Rasa Kopi    : ");
        if (kopi >= 25 && susu == 0) {
            printf("%sSangat Hitam & Pahit (Strong)%s\n", MERAH, RESET);
        } else if (susu > air) {
            printf("%sSangat Creamy (Dominan Susu)%s\n", KUNING, RESET);
        } else if (gula >= 30) {
            printf("%sSangat Manis%s\n", KUNING, RESET);
        } else {
            printf("%sSeimbang & Pas (Balanced)%s\n", HIJAU, RESET);
        }
    }
}
